# ============================================================
# IGNIS Orbital API — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o .env com valores reais.
# ============================================================

# Aplicação
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0

# Banco de dados (usado pelo FastAPI/SQLAlchemy — driver asyncpg)
DATABASE_URL=postgresql+asyncpg://ignis:ignis_secret@db:5432/ignis_db

# Banco de dados (variáveis individuais usadas pelo Docker Compose)
POSTGRES_USER=ignis
POSTGRES_PASSWORD=ignis_secret
POSTGRES_DB=ignis_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
# Com APP_ENV=production a API RECUSA iniciar se a chave tiver menos de 32
# caracteres ou for um dos valores-padrão publicados neste repositório.
JWT_SECRET_KEY=your-super-secret-key-change-in-production-never-commit-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — lista separada por vírgulas
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://ignis-fire-watch-main.vercel.app

# ============================================================
# Integrações externas (Fase 1 — branch feature/orbital-api-integrations)
# ============================================================

# Open-Meteo (sem chave — gratuito e aberto)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# NASA FIRMS — focos de calor satelital
# Obter MAP_KEY gratuitamente em: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Em branco: GET /api/v1/orbital-alerts retorna lista vazia com
# source_status=disabled_missing_api_key (nunca dados demo como se fossem reais).
# Com chave: dados reais da NASA mantidos só em cache de memória (persisted=false).
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# OpenStreetMap / Nominatim (sem chave — respeitar política de uso)
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Timeout e TTL de cache para chamadas externas
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_CACHE_TTL_MINUTES=60
# NOTA: o cache é in-memory por processo. Com --workers 2 (Railway), cada worker
# tem cache independente — máximo 2 chamadas por TTL por fonte. Aceitável para
# o volume atual. Para cache compartilhado use Redis (fase futura).

# ============================================================
# Sprint 0 — controles de segurança e honestidade dos dados
# ============================================================

# Focos orbitais fictícios só são retornados com true; vêm marcados com
# source_status=demo e is_demo=true. Nunca habilite em ambiente operacional.
ORBITAL_ALERTS_DEMO_MODE=false

# Seed demonstrativo (usuários com senhas públicas). Ignorado com
# APP_ENV=production, exceto com SEED_DEMO_DATA=true (somente demonstração).
SEED_DEMO_DATA=false

# Rate limiting em memória (por processo) para login, denúncias e endpoints públicos.
RATE_LIMIT_ENABLED=true
# true somente atrás de proxy confiável (Railway): usa o último X-Forwarded-For.
TRUST_PROXY_HEADERS=false
